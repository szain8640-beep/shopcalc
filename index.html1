<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopCalc Pro</title>
    
    <!-- Complete PWA Manifest Link -->
    <link rel="manifest" href="data:application/manifest+json;charset=utf-8,%7B%22name%22%3A%22ShopCalc%20Pro%22%2C%22short_name%22%3A%22ShopCalc%22%2C%22start_url%22%3A%22.%2F%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%23020617%22%2C%22theme_color%22%3A%22%234f46e5%22%2C%22description%22%3A%22E-Commerce%20Dropshipping%20Calculator%22%2C%22icons%22%3A%5B%7B%22src%22%3A%22https%3A%2F%2Fimg.icons8.com%2Ffluency%2F512%2Fcalculator.png%22%2C%22sizes%22%3A%22512x512%22%2C%22type%22%3A%22image%2Fpng%22%2C%22purpose%22%3A%22any%20maskable%22%7D%5D%7D">
    <meta name="theme-color" content="#4f46e5">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen p-4 md:p-6 pb-20">

    <div class="max-w-md mx-auto space-y-6">
        
        <!-- App Header -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 shadow-2xl flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600/20 p-3 rounded-2xl text-indigo-400">
                    <i data-lucide="calculator" class="w-7 h-7"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold text-white">ShopCalc Pro</h1>
                    <p class="text-[11px] text-slate-400">Seller Profit & Expense Calculator</p>
                </div>
            </div>
            <span class="bg-emerald-500/10 text-emerald-400 text-[10px] px-2.5 py-1 rounded-full font-semibold">v1.0 Ready</span>
        </div>

        <!-- Tool Tab 1: Profit Calculator -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 shadow-2xl space-y-4">
            <h2 class="text-xs font-semibold uppercase text-slate-400 tracking-wider flex items-center space-x-2">
                <i data-lucide="trending-up" class="w-4 h-4 text-indigo-400"></i>
                <span>Dropshipping Profit Calculator</span>
            </h2>

            <div class="space-y-3">
                <div>
                    <label class="block text-[11px] font-medium text-slate-400 mb-1">Sourcing Cost (Buying Price in PKR)</label>
                    <input type="number" id="buyPrice" placeholder="e.g. 1000" oninput="calculateProfit()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-indigo-500 text-white font-semibold">
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-400 mb-1">Selling Price (Customer Price in PKR)</label>
                    <input type="number" id="sellPrice" placeholder="e.g. 2500" oninput="calculateProfit()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-indigo-500 text-white font-semibold">
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-400 mb-1">Delivery / Shipping Expense (PKR)</label>
                    <input type="number" id="shipPrice" placeholder="e.g. 250" oninput="calculateProfit()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-indigo-500 text-white font-semibold">
                </div>
            </div>

            <!-- Result Box -->
            <div class="bg-slate-950 border border-slate-800 p-4 rounded-2xl space-y-2">
                <div class="flex justify-between text-xs">
                    <span class="text-slate-400">Net Profit:</span>
                    <span id="netProfitDisplay" class="font-bold text-emerald-400 text-sm">Rs. 0</span>
                </div>
                <div class="flex justify-between text-xs">
                    <span class="text-slate-400">Profit Margin:</span>
                    <span id="profitMarginDisplay" class="font-semibold text-indigo-400">0%</span>
                </div>
            </div>
        </div>

    </div>

    <script>
        lucide.createIcons();

        function calculateProfit() {
            const buy = parseFloat(document.getElementById('buyPrice').value) || 0;
            const sell = parseFloat(document.getElementById('sellPrice').value) || 0;
            const ship = parseFloat(document.getElementById('shipPrice').value) || 0;

            const profit = sell - (buy + ship);
            const margin = sell > 0 ? ((profit / sell) * 100).toFixed(1) : 0;

            const profitDisplay = document.getElementById('netProfitDisplay');
            profitDisplay.innerText = `Rs. ${profit.toLocaleString()}`;
            
            if (profit > 0) {
                profitDisplay.className = "font-bold text-emerald-400 text-sm";
            } else {
                profitDisplay.className = "font-bold text-red-400 text-sm";
            }

            document.getElementById('profitMarginDisplay').innerText = `${margin}%`;
        }
    </script>
</body>
</html>
